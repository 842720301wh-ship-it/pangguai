{
  "name": "panguai",
  "version": "0.4.4",
  "private": true,
  "panguai": {
    "displayName": "水到渠成",
    "androidVersionCode": 8
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --web",
    "build:backend": "node scripts/build.mjs --backend",
    "build:android": "node scripts/build.mjs --android",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "check:ui": "node scripts/qa/check-ui.mjs",
    "check:ui:about": "node scripts/qa/check-about-ui.mjs",
    "format": "prettier --write \"frontend/src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" package.json frontend/package.json .prettierrc.json",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" package.json frontend/package.json .prettierrc.json"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "prettier": "3.6.2"
  }
}
